# Copy this file to backend/.env and fill in real values. NEVER commit the real .env.

APP_NAME=Mudranalaya ERP-MIS
ENVIRONMENT=development
DEBUG=true

# Development: SQLite, zero setup.
DATABASE_URL=sqlite:///./data/mudranalaya.db
# Production (office server with PostgreSQL), example:
# DATABASE_URL=postgresql+psycopg2://erp_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/mudranalaya_erp

# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
SESSION_IDLE_TIMEOUT_MINUTES=30

# Comma-separated list of office LAN origins allowed to call this API.
# NEVER "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png

BACKUP_DIR=./data/backups

LICENSE_PUBLIC_KEY_PATH=./data/license/public_key.pem
LICENSE_TOKEN_PATH=./data/license/license_token.json
